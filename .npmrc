# pnpm. Flat node_modules (like npm) so React Native / Expo autolinking, the local
# modules/background-session module and MapLibre SPM resolve as before. Isolated installs: later PR.
node-linker=hoisted
# Same as npm's legacy-peer-deps: don't install peers nobody listed (they'd be autolinked into the
# native build) and only warn on peer conflicts.
strict-peer-dependencies=false
auto-install-peers=false
