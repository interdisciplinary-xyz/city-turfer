{
  "permissions": {
    "allow": [
      "Bash(node tools/:*)",
      "Bash(pnpm -C apps/mobile exec tsc:*)",
      "Bash(pnpm -C apps/mobile exec jest:*)",
      "Bash(pnpm -C apps/mobile exec expo install:*)",
      "Bash(pnpm -C apps/mobile exec expo start:*)",
      "Bash(pnpm -C apps/mobile exec expo run:*)",
      "Bash(pnpm -C apps/mobile exec expo prebuild:*)",
      "Bash(node apps/mobile/tools/:*)",
      "Bash(apps/mobile/tools/sim-location.sh:*)",
      "Bash(pnpm exec turbo run:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run:*)",
      "Bash(xcrun simctl:*)",
      "Bash(adb devices:*)",
      "Bash(adb emu geo:*)",
      "Bash(adb shell input:*)",
      "Bash(maestro test:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-ts.sh"
          }
        ]
      }
    ]
  }
}
