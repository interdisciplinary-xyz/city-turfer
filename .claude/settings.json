{
  "permissions": {
    "allow": [
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec jest:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm exec expo install:*)",
      "Bash(pnpm exec expo start:*)",
      "Bash(pnpm exec expo run:*)",
      "Bash(pnpm exec expo prebuild:*)",
      "Bash(node tools/:*)",
      "Bash(tools/sim-location.sh:*)",
      "Bash(xcrun simctl:*)",
      "Bash(adb devices:*)",
      "Bash(adb emu geo:*)",
      "Bash(adb shell input:*)",
      "Bash(maestro test:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-ts.sh" }]
      }
    ]
  }
}
