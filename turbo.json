{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "lint": { "outputs": [] },
    "arch": { "outputs": [] },
    "test:unit": { "dependsOn": ["^typecheck"], "outputs": [], "env": ["PAYLOAD_TEST_DATABASE_URL"] },
    "@cityturfer/web#test:unit": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/openapi.json", "$TURBO_ROOT$/packages/core/src/**"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["typecheck"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "storybook-static/**", "dist/**"]
    },
    "dev": { "cache": false, "persistent": true }
  }
}
