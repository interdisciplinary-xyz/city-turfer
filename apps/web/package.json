{
  "name": "@cityturfer/web",
  "version": "0.7.0",
  "private": true,
  "description": "CityTurfer landing page: a static showcase (Next.js static export, hosted on Vercel)",
  "scripts": {
    "dev": "portless run --lan --name cityturfer -- node server.mjs",
    "build": "next build",
    "start": "npx --yes serve@14 out",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src tools next.config.ts server.mjs"
  },
  "dependencies": {
    "@cityturfer/brand": "workspace:*",
    "@gsap/react": "^2.1.2",
    "@interdisciplinary/dev-toolbar": "workspace:*",
    "gsap": "^3.15.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@cityturfer/config": "workspace:*",
    "@interdisciplinary/eslint-config": "workspace:*",
    "@next/eslint-plugin-next": "^16.4.2",
    "@types/node": "^22.15.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "lucide-react": "^0.462.0",
    "portless": "^0.12.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  }
}
