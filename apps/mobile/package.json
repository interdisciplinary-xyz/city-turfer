{
  "name": "@cityturfer/mobile",
  "version": "0.3.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "pnpm run arch && jest",
    "test:unit": "jest && pnpm run test:tools",
    "test:tools": "node --test tools/__tests__/*.test.mjs",
    "test:cov": "jest --coverage",
    "test:e2e": "e2e/run.sh",
    "e2e:audit": "node tools/e2e/audit.mjs",
    "lint": "eslint src index.ts tools"
  },
  "dependencies": {
    "@cityturfer/brand": "workspace:*",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "expo": "~57.0.29",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "^57.0.3",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.26",
    "h3-js": "^4.5.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@cityturfer/config": "workspace:*",
    "@react-native/jest-preset": "^0.87.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.15",
    "better-sqlite3": "^13.0.3",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.6",
    "typescript": "~6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "watchman": false,
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/test-support/**",
      "!**/*.d.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tools/",
      "/.claude/worktrees/"
    ],
    "globals": {
      "__DEV__": true
    },
    "modulePathIgnorePatterns": [
      "/.claude/worktrees/"
    ]
  },
  "engines": {
    "node": ">=22.13"
  }
}
