{
  "expo": {
    "name": "CityTurfer",
    "slug": "turftrack",
    "scheme": "turftrack",
    "version": "0.3.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.turftrack.poc",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "CityTurfer"
      },
      "appleTeamId": "KD9S2F8UCY"
    },
    "android": {
      "package": "com.turftrack.poc",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CityTurfer records your route while you walk, run or ride \u2014 including when the screen is off \u2014 so every street you cover becomes your turf.",
          "locationWhenInUsePermission": "CityTurfer shows where you are and records your route.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "./plugins/with-local-maplibre",
      "./plugins/with-scene-lifecycle",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0D12",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0D12"
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/61b71526-4472-400c-a271-19a538294255",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61b71526-4472-400c-a271-19a538294255"
      }
    },
    "owner": "mdopito"
  }
}
