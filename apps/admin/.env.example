# apps/admin: copy to apps/admin/.env.local (never committed; the secret-file guard blocks .env files).
# Admin's OWN database (decision AD2). Never the API's DATABASE_URL.
PAYLOAD_DATABASE_URL=postgres://postgres@127.0.0.1:5432/cityturfer_admin
# 32+ random characters: openssl rand -hex 32
PAYLOAD_SECRET=
# The admin's public origin (CSRF and CORS allow only this one). In dev the panel is
# https://cityturfer.local/admin: `pnpm run web:dev` proxies /admin to the admin's dev server
# (http://127.0.0.1:3100; apps/web reads ADMIN_DEV_URL if you run it elsewhere).
# MIGRATING: if your .env still says https://admin.cityturfer.local, change it to the line below,
# otherwise sign-in loops back to the login page (the dev server warns about it at startup).
# PRODUCTION: the admin gets its OWN origin (e.g. https://admin.<domain>, panel at /admin), never
# the public site's origin or a rewrite under it. The shared origin is dev only; the committed
# value below must never reach staging or production.
ADMIN_URL=https://cityturfer.local
