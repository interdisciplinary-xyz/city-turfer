{
  "name": "city-turfer",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "start": "pnpm --filter @cityturfer/mobile start",
    "ios": "pnpm --filter @cityturfer/mobile ios",
    "android": "pnpm --filter @cityturfer/mobile android",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "release": "commit-and-tag-version",
    "standard": "pnpm run standard:format && pnpm run standard:lint",
    "standard:fix": "pnpm run standard:lint:fix && pnpm run standard:format:fix",
    "standard:format": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "standard:format:fix": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "standard:lint": "eslint apps/mobile/src apps/mobile/index.ts apps/mobile/tools tools",
    "standard:lint:fix": "eslint apps/mobile/src apps/mobile/index.ts apps/mobile/tools tools --fix",
    "typecheck": "turbo run typecheck",
    "test:types": "turbo run typecheck",
    "test:arch": "turbo run arch",
    "test": "turbo run arch test:unit && pnpm run test:tools",
    "test:unit": "turbo run test:unit && pnpm run test:tools",
    "test:tools": "node --test tools/__tests__/*.test.mjs",
    "test:e2e": "pnpm --filter @cityturfer/mobile test:e2e",
    "e2e:audit": "pnpm --filter @cityturfer/mobile e2e:audit",
    "audit:logs": "node tools/audit-logs.mjs",
    "check:secret-files": "node tools/check-secret-files.mjs",
    "audit:docs": "node tools/docs-audit.mjs",
    "ci:quality": "pnpm run standard && turbo run typecheck arch test:unit && pnpm run test:tools && pnpm run audit:logs && pnpm run e2e:audit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "commit-and-tag-version": "^12.7.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}
