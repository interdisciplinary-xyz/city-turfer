{
  "name": "city-turfer",
  "version": "0.2.0",
  "main": "index.ts",
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.5.0",
    "expo": "~57.0.29",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "^57.0.3",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.26",
    "h3-js": "^4.5.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@react-native/jest-preset": "^0.87.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.15",
    "better-sqlite3": "^13.0.3",
    "commit-and-tag-version": "^12.7.3",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.6",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "npm run arch && jest",
    "jest": "jest",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "release": "commit-and-tag-version",
    "standard": "npm run standard:format && npm run standard:lint",
    "standard:fix": "npm run standard:lint:fix && npm run standard:format:fix",
    "standard:format": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "standard:format:fix": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "standard:lint": "eslint src index.ts tools",
    "standard:lint:fix": "eslint src index.ts tools --fix",
    "test:types": "tsc --noEmit",
    "test:unit": "jest && npm run test:tools",
    "test:tools": "node --test tools/__tests__/*.test.mjs",
    "test:cov": "jest --coverage",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs",
    "test:e2e": "e2e/run.sh",
    "audit:logs": "node tools/audit-logs.mjs",
    "check:secret-files": "node tools/check-secret-files.mjs",
    "ci:quality": "npm run standard && npm run test:types && npm run test:arch && npm run test:unit && npm run audit:logs"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "watchman": false,
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/test-support/**",
      "!**/*.d.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tools/"
    ],
    "globals": {
      "__DEV__": true
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}
