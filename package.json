{
  "name": "city-turfer",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "start": "pnpm --filter @cityturfer/mobile start",
    "ios": "pnpm --filter @cityturfer/mobile ios",
    "android": "pnpm --filter @cityturfer/mobile android",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "release": "commit-and-tag-version",
    "standard": "pnpm run standard:format && pnpm run standard:lint",
    "standard:fix": "pnpm run standard:lint:fix && pnpm run standard:format:fix",
    "standard:format": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "standard:format:fix": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "standard:lint": "eslint tools && turbo run lint",
    "standard:lint:fix": "eslint tools --fix && turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test:types": "turbo run typecheck",
    "test:arch": "turbo run arch",
    "test": "turbo run arch test:unit && pnpm run test:tools",
    "test:unit": "turbo run test:unit && pnpm run test:tools",
    "test:tools": "node --test tools/__tests__/*.test.mjs",
    "test:e2e": "pnpm --filter @cityturfer/mobile test:e2e",
    "e2e:audit": "pnpm --filter @cityturfer/mobile e2e:audit",
    "audit:logs": "node tools/audit-logs.mjs",
    "check:secret-files": "node tools/check-secret-files.mjs",
    "audit:docs": "node tools/docs-audit.mjs",
    "audit:harness": "node tools/harness-audit.mjs",
    "ci:quality": "pnpm run standard:format && pnpm run standard:lint && turbo run typecheck arch test:unit build && pnpm run test:tools && pnpm run audit:logs && pnpm run audit:harness && pnpm run e2e:audit",
    "build": "turbo run build",
    "web:dev": "pnpm --filter @cityturfer/web dev"
  },
  "prettier": "@cityturfer/config/prettier",
  "devDependencies": {
    "@cityturfer/config": "workspace:*",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@interdisciplinary/eslint-config": "workspace:*",
    "commit-and-tag-version": "^12.7.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}
