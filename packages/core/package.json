{
  "name": "@cityturfer/core",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "CityTurfer core: the shared kernel, core constants and the domain + application layers of Territory, Activity Log, Achievements and Identity, so the phone and the server run the same rules. Plain TS source, no React, Expo or native code; H3 only behind the separate @cityturfer/core/h3 entry.",
  "exports": {
    "./constants": "./src/constants/index.ts",
    "./shared-kernel": "./src/shared-kernel/index.ts",
    "./territory": "./src/contexts/territory/index.ts",
    "./territory/ports": "./src/contexts/territory/ports.ts",
    "./activity-log": "./src/contexts/activity-log/index.ts",
    "./activity-log/ports": "./src/contexts/activity-log/ports.ts",
    "./achievements": "./src/contexts/achievements/index.ts",
    "./identity": "./src/contexts/identity/index.ts",
    "./identity/ports": "./src/contexts/identity/ports.ts",
    "./h3": "./src/h3/index.ts",
    "./demo": "./src/demo/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test:unit": "jest"
  },
  "dependencies": {
    "h3-js": "4.5.0"
  },
  "devDependencies": {
    "@cityturfer/config": "workspace:*",
    "@interdisciplinary/eslint-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "babel-preset-expo": "^57.0.15",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "watchman": false,
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test-support/"
    ]
  }
}
