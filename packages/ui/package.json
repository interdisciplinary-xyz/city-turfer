{
  "name": "@cityturfer/ui",
  "version": "0.12.0",
  "private": true,
  "description": "CityTurfer design system: React Native components on @cityturfer/brand tokens. TS source, peer dependencies only, no native code (rendered on the web through react-native-web in apps/storybook).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "jest"
  },
  "dependencies": {
    "@cityturfer/brand": "workspace:*"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@cityturfer/config": "workspace:*",
    "@interdisciplinary/eslint-config": "workspace:*",
    "@react-native/jest-preset": "~0.86.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "~19.1.0",
    "babel-preset-expo": "^57.0.15",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "jest": "^30.5.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "watchman": false,
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    }
  }
}
