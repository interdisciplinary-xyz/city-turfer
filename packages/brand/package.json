{
  "name": "@cityturfer/brand",
  "version": "0.8.0",
  "private": true,
  "description": "CityTurfer brand: colour tokens (the turf strength ramp), name and copy, logo SVGs. Plain TS + SVG, no React.",
  "exports": {
    ".": "./src/index.ts",
    "./svg/*": "./svg/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "jest"
  },
  "devDependencies": {
    "@cityturfer/config": "workspace:*",
    "@interdisciplinary/eslint-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "babel-preset-expo": "^57.0.15",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "watchman": false,
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    }
  }
}
